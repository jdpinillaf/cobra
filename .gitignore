# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# videos de la demo: se regeneran con `pnpm grabar`
/video

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.vitest.json
.auditoria.jsonl
.vitest-e2e.json
.pglite/

# Ojo: `public/llamadas` y `demo/` **sí** van al repo, aunque sean generados.
# Vercel construye desde git, así que ignorarlos dejaría el sitio desplegado sin
# los audios que la pantalla de Briefing reproduce. Pesan unos 4 MB entre todos.
